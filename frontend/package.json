{
  "name": "cc-switch-router-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/raster-flags.mjs",
    "prebuild": "node scripts/raster-flags.mjs",
    "build": "next build",
    "lint": "tsc --noEmit",
    "flags:raster": "node scripts/raster-flags.mjs",
    "test:flags": "node scripts/raster-flags.mjs && node --test scripts/raster-flags.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:operational-status": "tsx --test components/dashboard/operational-status.test.ts",
    "test:share-market": "tsx --test components/dashboard/share-market/buyer-catalog-utils.test.ts",
    "test:token-units": "tsx --test lib/token-units.test.ts",
    "test:share-model-probe": "tsx --test lib/share-model-probe.test.ts",
    "test:share-model-health-heatmap": "tsx --test components/dashboard/share-model-health-heatmap.test.ts components/dashboard/client-online-heatmap.test.ts",
    "audit:settings-i18n": "node ../scripts/audit/audit-settings-i18n.mjs --check",
    "audit:settings-contract": "node ../scripts/audit/audit-settings-contract.mjs --check",
    "audit:market-billing-contract": "node ../scripts/audit/audit-market-billing-contract.mjs --check",
    "audit:web-token-units": "node ../scripts/audit/audit-web-token-units.mjs --check",
    "audit:share-model-health-contract": "node ../scripts/audit/audit-share-model-health-contract.mjs --check"
  },
  "dependencies": {
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "latest",
    "dompurify": "^3.2.6",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.20.5",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
